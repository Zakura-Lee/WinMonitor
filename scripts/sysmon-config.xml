<?xml version="1.0" encoding="utf-8"?>
<!--
    WinMonitor 使用的 Sysmon 配置

    关注点：
        1. ProcessCreate (1)  —— 进程创建，含命令行、父进程、哈希
        2. ProcessTerminate (5) —— 进程退出
        3. NetworkConnect (3) —— 网络连接

    NetworkConnect 用「排除法」表达：只排除 svchost，其余全部记录。
    如果某些事件类型没有出现在这里，Sysmon 会按默认策略处理，
    实测默认安装下 NetworkConnect 并不落日志，所以必须显式声明。

    应用方式（管理员）：
        Sysmon64.exe -c sysmon-config.xml
-->
<Sysmon schemaversion="4.90">
  <HashAlgorithms>sha256</HashAlgorithms>

  <EventFiltering>
    <RuleGroup name="" groupRelation="or">
      <NetworkConnect onmatch="exclude">
        <!-- 系统服务产生的连接量极大且噪声高，先排除 -->
        <Image condition="is">C:\Windows\System32\svchost.exe</Image>
      </NetworkConnect>
    </RuleGroup>

    <RuleGroup name="" groupRelation="or">
      <ProcessCreate onmatch="exclude" />
      <ProcessTerminate onmatch="exclude" />
    </RuleGroup>
  </EventFiltering>
</Sysmon>
