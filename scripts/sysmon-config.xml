<?xml version="1.0" encoding="utf-8"?>
<!--
    WinMonitor 使用的 Sysmon 配置

    实测现象：默认安装（不带配置文件）时 Sysmon 只记录 ProcessCreate(1)
    与 ProcessTerminate(5)，NetworkConnect(3) 并不落日志。
    因此这里显式声明一次 NetworkConnect，用「排除法」表达：
    只排除 svchost，其余连接全部记录。

    未在配置中出现的其他事件类型保持 Sysmon 默认行为。

    应用方式（管理员，无需重装）：
        Sysmon64.exe -c "F:\Security Tool Development\WinMonitor\scripts\sysmon-config.xml"

    查看生效配置：
        Sysmon64.exe -c
-->
<Sysmon schemaversion="4.90">
  <HashAlgorithms>sha256</HashAlgorithms>

  <EventFiltering>
    <RuleGroup name="" groupRelation="or">
      <NetworkConnect onmatch="exclude">
        <!-- 系统服务产生的连接量极大且噪声高，先排除 -->
        <Image condition="is">C:\Windows\System32\svchost.exe</Image>
      </NetworkConnect>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
